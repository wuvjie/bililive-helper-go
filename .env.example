# =================================================================
# Bililive Helper Go 部署环境配置示例
#
# 使用说明：
# 复制此文件为 .env：
#   cp .env.example .env
# 并根据实际宿主机路径和需求修改下方参数。
#
# 适用场景：
# 1. Docker Compose: docker compose up -d (自动读取当前目录 .env)
# 2. Docker CLI: docker run --env-file .env ...
# 3. WSL Container: wslc run --env-file .env ...
# =================================================================

# ----------------- 1. 核心目录映射 (必填/建议指定) -----------------
# 录像存储目录（宿主机实际路径，即 bililive-go 的录制输出根目录）
# 通用路径示例: /path/to/recordings 或 ./recordings (群晖 NAS 常见为 /volume1/...)
# Windows/WSL 示例: D:\video\recordings 或 /mnt/d/video/recordings
RECORDINGS_DIR=./recordings

# 配置、日志、凭据持久化数据目录（宿主机实际路径）
# 通用路径示例: /path/to/data 或 ./data (群晖 NAS 常见为 /volume1/...)
# Windows/WSL 示例: D:\docker\bililive-helper-go 或 ./data
DATA_DIR=./data

# ----------------- 2. 服务端口与时区 -----------------
# Web 界面访问端口（宿主机对外暴露端口，访问地址：http://IP:PORT）
PORT=5689

# 容器时区（默认 Asia/Shanghai）
TZ=Asia/Shanghai

# ----------------- 3. 资源限制 (可选，仅在需要限制容器占用时取消注释) -----------------
# 容器最大可用 CPU 核心数
# CPU_LIMIT=2.0

# 容器最大可用内存
# MEM_LIMIT=4G

# ----------------- 4. 安全与可选高级配置 -----------------
# 登录密码（若留空，首次启动时通过 Web 端初始化向导设置）
# PASSWORD=your_password

# 是否启用 Cookie Secure 属性（仅在配置了 HTTPS 反向代理时设为 true）
# COOKIE_SECURE=false

# 任务完成通知 Webhook（支持 Bark、飞书、钉钉、Slack 等兼容接口）
# WEBHOOK_URL=https://your-webhook-url

# API Token（用于第三方程序通过 Authorization: Bearer <TOKEN> 访问 API）
# API_TOKEN=your_secret_token
